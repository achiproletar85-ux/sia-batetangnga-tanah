# =====================================================
# 1. SALIN file ini menjadi ".env" lalu isi nilainya
# =====================================================

# Supabase (bisa pakai project yang sama dengan aplikasi SIA)
SUPABASE_URL=
# Gunakan SERVICE_ROLE_KEY agar bebas baca/tulis (server-only, JANGAN di frontend)
SUPABASE_SERVICE_ROLE_KEY=

# 2. Port server aplikasi (bedakan dari aplikasi SIA)
PORT=3344

# =====================================================
# 3. IMPORT MANUAL DARI SPREADSHEET (opsional)
#    Dipakai tombol "Tarik dari Sheet" -> GAS read-only -> Supabase.
#    Deploy gas/Code.gs sebagai Web App lalu isi URL-nya.
# =====================================================
GAS_SYNC_WEB_APP_URL=
GAS_SYNC_TOKEN=GANTI_RAHASIA_PANJANG

# =====================================================
# 4. AUTH LOGIN APLIKASI (opsional, ada default)
#    Kredensial seed saat pertama kali login. Setelah login
#    pertama, kata sandi tersimpan di tabel app_users (Supabase)
#    dan bisa diubah lewat menu "Ubah Sandi" di aplikasi.
# =====================================================
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_NAME=Admin Desa
# Wajib ganti dengan string acak panjang untuk menandatangani token sesi.
SESSION_SECRET=GANTI_RAHASIA_SESI_PANJANG
