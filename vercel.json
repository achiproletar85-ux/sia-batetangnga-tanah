{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sporadik",
      "destination": "/sporadik-executive.html"
    },
    {
      "source": "/label",
      "destination": "/label-undangan.html"
    },
    {
      "source": "/label-undangan",
      "destination": "/label-undangan.html"
    },
    {
      "source": "/cetak-label",
      "destination": "/label-undangan.html"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
